<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="focusPercent" type="float" onChange="onFocus" />
        <field id="rowFocusPercent" type="float" />
        <field id="itemHasFocus" type="boolean" />
        <field id="rowHasFocus" type="boolean" />
    </interface>
    <script type="text/brightscript" uri="libpkg:/components/Utils.brs" />
    <script type="text/brightscript" uri="libpkg:/components/PosterCard.brs" />
    <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
    <children>
        <Group id="card">
            <Poster id="bg" uri="libpkg:/images/card.9.png" />
            <Label id="placeholder" horizAlign="center" vertAlign="center" wrap="true" color="0x8D97A3FF" />
            <Poster id="img" loadDisplayMode="scaleToFill" loadWidth="230" loadHeight="345" visible="false" />
            <Poster id="corners" uri="libpkg:/images/corners_poster.png" width="230" height="345" visible="false" />
            <Poster id="logo" loadDisplayMode="scaleToFit" loadWidth="288" loadHeight="142" visible="false" />
            <Poster id="ring" uri="libpkg:/images/ring.9.png" opacity="0" />
        </Group>
        <Label id="title" color="0x8D97A3FF" />
    </children>
</component>
