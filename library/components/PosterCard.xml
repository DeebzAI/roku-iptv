<?xml version="1.0" encoding="utf-8"?>
<component name="PosterCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <field id="rowFocusPercent" type="float" />
    <field id="itemHasFocus" type="boolean" />
    <field id="rowHasFocus" type="boolean" />
  </interface>
  <children>
    <Group id="card">
      <Poster id="bg" uri="libpkg:/images/card.9.png" />
      <!-- shown when there's no artwork (or it fails to load) -->
      <Label id="placeholder" horizAlign="center" vertAlign="center" wrap="true" maxLines="3" color="0xE6E9EDFF" />
      <Poster id="img" loadDisplayMode="scaleToFill" loadWidth="230" loadHeight="345" visible="false" />
      <Poster id="corners" uri="libpkg:/images/corners_poster.png" width="230" height="345" visible="false" />
      <Poster id="logo" loadDisplayMode="scaleToFit" loadWidth="288" loadHeight="142" visible="false" />

      <!-- scoreboard layout for games -->
      <Group id="game" visible="false">
        <Poster id="badgeBg" uri="libpkg:/images/pill.9.png" translation="[22,20]" height="40" />
        <Label id="badge" translation="[22,20]" height="40" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" />
        <Label id="league" translation="[180,20]" width="158" height="40" horizAlign="right" vertAlign="center" color="0x8D97A3FF" />
        <Label id="team1" translation="[24,78]" width="312" color="0xFFFFFFFF" />
        <Label id="team2" translation="[24,128]" width="312" color="0xC9D0D8FF" />
      </Group>

      <Poster id="ring" uri="libpkg:/images/ring.9.png" opacity="0" />
    </Group>
    <Label id="title" color="0x8D97A3FF" wrap="true" maxLines="2" />
  </children>
  <script type="text/brightscript" uri="libpkg:/components/Utils.brs" />
  <script type="text/brightscript" uri="libpkg:/components/PosterCard.brs" />
</component>
