<?xml version="1.0" encoding="utf-8"?>
<component name="GuideScreen" extends="Group">
  <interface>
    <field id="kind" type="string" />
    <field id="xtream" type="assocarray" />
    <field id="userAgent" type="string" />
    <field id="start" type="boolean" onChange="startLoading" />
    <field id="selectedInfo" type="assocarray" alwaysNotify="true" />
    <field id="focusedItem" type="node" />
    <field id="jumpStart" type="boolean" alwaysNotify="true" onChange="onJumpStart" />
    <field id="refreshFavs" type="boolean" alwaysNotify="true" />
    <field id="refreshContinue" type="boolean" alwaysNotify="true" />
  </interface>
  <children>
    <Label id="catName" translation="[100,140]" width="1000" color="0xFFFFFFFF" />
    <Poster uri="libpkg:/images/arrow_left.png" translation="[1470,152]" width="36" height="36" />
    <Poster uri="libpkg:/images/arrow_right.png" translation="[1516,152]" width="36" height="36" />
    <Label id="catHint" translation="[1566,150]" width="260" color="0xFFFFFF99" text="Change category" />
    <Label id="colNow" translation="[610,196]" width="400" color="0xFFFFFF59" text="NOW" />
    <Label id="colNext" translation="[1400,196]" width="400" color="0xFFFFFF59" text="UP NEXT" />
    <MarkupList id="list" translation="[100,232]" itemComponentName="GuideRow" />
    <Label id="status" translation="[0,600]" width="1920" horizAlign="center" color="0xFFFFFF99" />
  </children>
  <script type="text/brightscript" uri="libpkg:/components/Utils.brs" />
  <script type="text/brightscript" uri="libpkg:/components/GuideScreen.brs" />
</component>
