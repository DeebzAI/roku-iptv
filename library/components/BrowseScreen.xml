<?xml version="1.0" encoding="utf-8"?>
<component name="BrowseScreen" extends="Group">
  <interface>
    <field id="kind" type="string" />
    <field id="xtream" type="assocarray" />
    <field id="userAgent" type="string" />
    <field id="start" type="boolean" onChange="startLoading" />
    <field id="selectedInfo" type="assocarray" alwaysNotify="true" />
    <field id="focusedItem" type="node" />
    <field id="refreshFavs" type="boolean" alwaysNotify="true" onChange="onRefreshFavs" />
    <field id="refreshContinue" type="boolean" alwaysNotify="true" onChange="onRefreshContinue" />
  </interface>
  <children>
    <Group id="hero">
      <Poster id="heroBackdrop" translation="[520,0]" width="1400" height="788" loadDisplayMode="scaleToZoom" loadWidth="1280" loadHeight="720" visible="false" />
      <Poster id="heroPoster" translation="[1440,120]" width="330" height="495" loadDisplayMode="scaleToFit" loadWidth="330" loadHeight="495" visible="false" />
      <Poster id="heroLogo" translation="[1180,120]" width="620" height="350" loadDisplayMode="scaleToFit" loadWidth="620" loadHeight="350" visible="false" />
      <Group id="heroTeams" visible="false">
        <Poster id="heroTeamA" translation="[1180,150]" width="270" height="270" loadDisplayMode="scaleToFit" loadWidth="270" loadHeight="270" />
        <Label id="heroAt" translation="[1450,240]" width="110" horizAlign="center" color="0x8D97A3FF" />
        <Poster id="heroTeamB" translation="[1560,150]" width="270" height="270" loadDisplayMode="scaleToFit" loadWidth="270" loadHeight="270" />
      </Group>
      <Poster id="heroFade" width="1920" height="1080" uri="libpkg:/images/hero_fade.png" />
      <Label id="heroTitle" translation="[100,160]" width="1150" wrap="true" maxLines="2" color="0xFFFFFFFF" />
      <Label id="heroMeta" translation="[100,300]" width="1150" color="0xB8C0C8FF" />
      <Rectangle id="heroBarBg" translation="[100,352]" width="420" height="6" color="0x2E3742FF" visible="false" />
      <Rectangle id="heroBar" translation="[100,352]" width="0" height="6" color="0xFFFFFFFF" visible="false" />
      <Label id="heroDesc" translation="[100,375]" width="1050" height="140" wrap="true" maxLines="3" color="0xD0D6DCFF" />
    </Group>
    <RowList id="rows" translation="[100,585]" />
    <Label id="status" translation="[0,700]" width="1920" horizAlign="center" color="0x8D97A3FF" />
  </children>
  <script type="text/brightscript" uri="libpkg:/components/Utils.brs" />
  <script type="text/brightscript" uri="libpkg:/components/BrowseScreen.brs" />
</component>
