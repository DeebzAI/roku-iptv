<?xml version="1.0" encoding="utf-8"?>
<component name="AppRoot" extends="Group">
  <children>
    <Rectangle width="1920" height="1080" color="0x0E1116FF" />
    <Group id="screens" />
    <NavBar id="nav" translation="[0,64]" visible="false" />
    <Label id="clock" translation="[1560,76]" width="280" horizAlign="right" color="0xB8C0C8FF" />
    <Group id="detailsHost" />
    <Label id="status" translation="[0,500]" width="1920" horizAlign="center" wrap="true" color="0xFFFFFFFF" />
    <!-- banner for short confirmations (e.g. favorites) -->
    <Group id="banner" visible="false">
      <Poster id="bannerBg" uri="libpkg:/images/pill.9.png" blendColor="0x2A3340F2" height="72" />
      <Label id="bannerText" height="72" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" />
    </Group>

    <Video id="video" width="1920" height="1080" visible="false" />

    <!-- player info bar: fades up from the bottom -->
    <Group id="osd" visible="false">
      <Poster translation="[0,560]" width="1920" height="520" uri="libpkg:/images/osd_fade.png" />
      <Poster id="osdLogo" translation="[1500,800]" width="320" height="180" loadDisplayMode="scaleToFit" loadWidth="320" loadHeight="180" />
      <Group id="osdLive" translation="[100,790]">
        <Rectangle id="osdDot" translation="[0,9]" width="16" height="16" color="0xE5484DFF" />
        <Label id="osdLiveText" translation="[28,0]" text="LIVE" color="0xE5484DFF" />
      </Group>
      <Label id="osdTag" translation="[200,790]" width="900" color="0xA0A8B0FF" />
      <Label id="osdChannel" translation="[100,830]" width="1350" color="0xFFFFFFFF" />
      <Label id="osdNow" translation="[100,905]" width="1350" color="0xE6E9EDFF" />
      <Rectangle id="osdBarBg" translation="[100,962]" width="900" height="6" color="0x404850FF" />
      <Rectangle id="osdBar" translation="[100,962]" width="0" height="6" color="0xFFFFFFFF" />
      <Label id="osdTime" translation="[1030,948]" width="500" color="0xA0A8B0FF" />
      <Label id="osdNext" translation="[100,990]" width="1350" color="0xA0A8B0FF" />
    </Group>

    <!-- channel strip while watching (OK) -->
    <Group id="strip" visible="false">
      <Poster translation="[0,480]" width="1920" height="600" uri="libpkg:/images/osd_fade.png" />
      <Label id="stripTitle" translation="[100,640]" width="1720" color="0xFFFFFFFF" />
      <RowList id="stripList" translation="[100,700]" />
    </Group>
  </children>
  <script type="text/brightscript" uri="libpkg:/components/Utils.brs" />
  <script type="text/brightscript" uri="libpkg:/components/AppRoot.brs" />
</component>
