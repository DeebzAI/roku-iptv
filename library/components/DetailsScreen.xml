<?xml version="1.0" encoding="utf-8"?>
<component name="DetailsScreen" extends="Group">
  <interface>
    <field id="xtream" type="assocarray" />
    <field id="userAgent" type="string" />
    <field id="item" type="node" onChange="onItem" />
    <field id="playRequest" type="assocarray" alwaysNotify="true" />
  </interface>
  <children>
    <Rectangle width="1920" height="1080" color="0x0E1116FF" />
    <Poster id="backdrop" translation="[520,0]" width="1400" height="788" loadDisplayMode="scaleToZoom" loadWidth="1280" loadHeight="720" visible="false" />
    <Poster id="poster" translation="[1440,120]" width="330" height="495" loadDisplayMode="scaleToFit" loadWidth="330" loadHeight="495" visible="false" />
    <Poster width="1920" height="1080" uri="libpkg:/images/hero_fade.png" />
    <Label id="title" translation="[100,130]" width="1200" height="80" color="0xFFFFFFFF" />
    <Label id="meta" translation="[100,228]" width="1200" color="0xB8C0C8FF" />
    <Label id="plot" translation="[100,285]" width="1050" height="200" wrap="true" maxLines="5" color="0xD0D6DCFF" />

    <Group id="playBtn" translation="[100,540]" focusable="true">
