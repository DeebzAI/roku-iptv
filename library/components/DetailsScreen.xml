<?xml version="1.0" encoding="utf-8"?>
<component name="DetailsScreen" extends="Group">
  <interface>
    <field id="xtream" type="assocarray" />
    <field id="userAgent" type="string" />
    <field id="item" type="node" onChange="onItem" />
    <field id="playRequest" type="assocarray" alwaysNotify="true" />
    <field id="refresh" type="boolean" alwaysNotify="true" onChange="refreshResume" />
  </interface>
  <children>
    <Rectangle width="1920" height="1080" color="0x0A0A0AFF" />
    <Poster id="backdrop" translation="[520,0]" width="1400" height="788" loadDisplayMode="scaleToZoom" loadWidth="1280" loadHeight="720" visible="false" />
    <Poster id="poster" translation="[1440,120]" width="330" height="495" loadDisplayMode="scaleToFit" loadWidth="330" loadHeight="495" visible="false" />
    <Poster width="1920" height="1080" uri="libpkg:/images/hero_fade.png" />
    <Poster id="sideFade" uri="libpkg:/images/side_fade.png" width="1400" height="1080" loadDisplayMode="scaleToFill" />
    <Label id="title" translation="[100,130]" width="1200" height="80" color="0xFFFFFFFF" />
    <Label id="meta" translation="[100,228]" width="1200" color="0xFFFFFF99" />
    <Label id="plot" translation="[100,285]" width="1050" height="200" wrap="true" maxLines="5" color="0xFFFFFFFF" />

    <Label id="cast" translation="[100,700]" width="1000" height="36" color="0xFFFFFF59" visible="false" />

    <Group id="playBtn" translation="[100,540]" focusable="true">
      <Poster id="playPill" uri="libpkg:/images/pill.9.png" width="340" height="80" />
      <Label id="playLabel" width="340" height="80" horizAlign="center" vertAlign="center" text="Play" color="0x0A0A0AFF" />
    </Group>
    <Group id="restartBtn" translation="[470,540]" focusable="true" visible="false">
      <Poster id="restartPill" uri="libpkg:/images/pill.9.png" width="300" height="80" />
      <Label id="restartLabel" width="300" height="80" horizAlign="center" vertAlign="center" text="Start Over" color="0x0A0A0AFF" />
    </Group>

    <LabelList id="seasons" translation="[100,540]" itemSize="[300,62]" numRows="7" visible="false"
      vertFocusAnimationStyle="floatingFocus" color="0xFFFFFF99" focusedColor="0x0A0A0AFF"
      focusBitmapUri="libpkg:/images/pill.9.png" focusFootprintBitmapUri="libpkg:/images/card.9.png" />
    <LabelList id="episodes" translation="[440,540]" itemSize="[1380,62]" numRows="7" visible="false"
      vertFocusAnimationStyle="floatingFocus" color="0xFFFFFFFF" focusedColor="0x0A0A0AFF"
      focusBitmapUri="libpkg:/images/pill.9.png" />
    <Label id="status" translation="[100,560]" width="1200" color="0xFFFFFF99" />
  </children>
  <script type="text/brightscript" uri="libpkg:/components/Utils.brs" />
  <script type="text/brightscript" uri="libpkg:/components/DetailsScreen.brs" />
</component>
