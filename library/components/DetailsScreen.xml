      vertFocusAnimationStyle="floatingFocus" color="0xD0D6DCFF" focusedColor="0x0E1116FF"
      focusBitmapUri="libpkg:/images/pill.9.png" />
    <Label id="status" translation="[100,560]" width="1200" color="0x8D97A3FF" />
  </children>
  <script type="text/brightscript" uri="libpkg:/components/Utils.brs" />
  <script type="text/brightscript" uri="libpkg:/components/DetailsScreen.brs" />
</component>
